/ {
  aliases {
   app-led = &red_led_5; 
   pulse-in = &cny70_pulse;
  };

  pulse_sensor: pulse_sensor {
    compatible = "gpio-keys";

    cny70_pulse: pulse_0 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
      label = "CNY70 pulse";
    };
  };

  led_sensor0: led-sensor-0 {
    compatible = "engram,led-sensor";
    led-gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>;
    status = "okay";
  };

  led_sensor1: led-sensor-1 {
    compatible = "engram,led-sensor";
    led-gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
    status = "okay";
  };
};
