/ {
  aliases {
   app-led = &red_led_5; 
  };

  led_sensor0: led-sensor-0 {
    compatible = "engram,led-sensor";
    led-gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>;
    status = "okay";
  };

  led_sensor1: led-sensor-1 {
    compatible = "engram,led-sensor";
    led-gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
    status = "okay";
  };
};
